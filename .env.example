# Les cours, la recherche locale et les révisions fonctionnent sans service externe.
# Répertoire persistant du suivi personnel. Par défaut : .data/ à la racine.
# APP_DATA_DIR=/chemin/absolu/vers/mes-donnees

# Facultatif : traduction, assistance écrite et voix OpenAI, côté serveur uniquement.
# Placer la clé dans .env.local, jamais dans une variable NEXT_PUBLIC_*.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini

# Facultatif : désactiver la synthèse macOS (Lesya) sur ce serveur.
# Les fichiers audio déjà créés restent accessibles.
# AUDIO_DISABLE_LOCAL=1

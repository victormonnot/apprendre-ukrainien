# Nom d’hôte seul, sans protocole, chemin ni slash final.
APP_HOST=ukrainien.example.com

# Compte de l’accès privé au site ; identifiant sans espace.
APP_LOGIN=apprenant
# Coller un hash bcrypt entre apostrophes simples pour conserver les caractères $.
# Génération interactive : docker run --rm -it caddy:2.11.4-alpine caddy hash-password --algorithm bcrypt
APP_PASSWORD_HASH=''

# Secret partagé entre Caddy et l’application : 64 caractères hexadécimaux.
# Génération : openssl rand -hex 32
APP_PROXY_SECRET=

# Facultatif : assistance écrite et voix OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
